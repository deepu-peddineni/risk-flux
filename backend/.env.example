# Risk-Flux Backend Environment Variables
# Copy this to .env and fill in your values

DEBUG=true

# Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# New API keys (recommended) — from Settings → API → Publishable and secret API keys
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxx

# Legacy API keys (deprecated late 2026) — from Settings → API → Legacy API Keys
# Only needed if you haven't created the new keys yet
# SUPABASE_ANON_KEY=your_legacy_anon_key
# SUPABASE_SERVICE_KEY=your_legacy_service_role_key

# JWT — verify user access tokens from Supabase Auth
# Leave empty to auto-use JWKS endpoint (JWT Signing Keys — recommended)
# Or set to your legacy symmetric secret from Dashboard → Settings → API → JWT Secret
JWT_SECRET=

# Email — Resend (https://resend.com — free: 3000 emails/mo)
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@risk-flux.is-a.dev

# Frontend URL (for OAuth redirects and email links)
FRONTEND_URL=http://localhost:3000

# CORS — JSON array of allowed origins (for production, include your domain)
# ALLOWED_ORIGINS=["http://localhost:3000","https://risk-flux.is-a.dev"]
